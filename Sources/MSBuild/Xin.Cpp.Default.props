<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<EngineRoot>$(MSBuildThisFileDirectory)..\..\</EngineRoot>
		<ProjectRoot>$(MSBuildThisFileDirectory)..\..\</ProjectRoot>
	</PropertyGroup>
	<Import Condition="Exists('$(EngineRoot)Sources\MSBuild\Cpp.Default.props')" Project="$(EngineRoot)Sources\MSBuild\Cpp.Default.props" />
</Project>