<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">
	<!--stl override-->
	<Type Name="Xin::Skia::FSkiaScriptRun">
		<DisplayString>[{ScriptCode,en}, {BiDiLevel,en}, Text[{TextIndex}, {TextIndex+TextLength}), {U32String}</DisplayString>
	</Type>
	
	<Type Name="Xin::Skia::FSkiaShapeRun">
		<DisplayString>[{TextIndex}, {TextIndex+TextLength}), {U32String}, {FontFace}</DisplayString>
	</Type>

</AutoVisualizer>