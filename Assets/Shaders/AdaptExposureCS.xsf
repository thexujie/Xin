#include "Common.xsh"
#include "Utility.xsh"

Buffer<uint> Histogram;
RWBuffer<float> Exposure;

cbuffer ShaderParameter
{
    float TargetLuminance;
    float AdaptationRate;
    float MinExposure;
    float MaxExposure;
    uint PixelCount;
}

groupshared float CachedWeights[256];

[numthreads(256, 1, 1)]
void MainCS(uint GroupIndex : SV_GroupIndex)
{
    float Weights = (float) (GroupIndex * Histogram[GroupIndex]);

    // 1 2 4 8 16 32 64 128
    // 0+1 1 2+3 4 4+5 5 6+7 7 8+9 9 10+11 11 12+13 13 14+15 15 16+17 17 18+19 19 20+21 21 ......
    // 0+1+2+3 1+4 2+3+4+5 4+7 4+5+6+7 5+7 6+7+8+9 7+9 8+9+10+11 9+11 10+11+12+13 11+13 12+13+14+15 13+15
    //     14+15+16+17 15+17 16+17+18+19 17+19 18+19+20+21 19+21 20+21+22+23 21+23 ......
    // 0+1+2+3+4+5+6+7.....

    [unroll]
    for (uint LumaIndex = 1; LumaIndex < 256; LumaIndex *= 2)
    {
        CachedWeights[GroupIndex] = Weights; // Write
        GroupMemoryBarrierWithGroupSync(); // Sync
        Weights += CachedWeights[(GroupIndex + LumaIndex) % 256]; // Read
        GroupMemoryBarrierWithGroupSync(); // Sync
    }
    
    if (Weights == 0.0)
        return;

    float MinLog = Exposure[4];
    float MaxLog = Exposure[5];
    float LogRange = Exposure[6];
    float RcpLogRange = Exposure[7];

    float WeightedHistAvg = Weights / (max(1, PixelCount - Histogram[0])) - 1.0;
    float LogLuminanceAvg = exp2(WeightedHistAvg / 254.0 * LogRange + MinLog);
    float TargetExposure = TargetLuminance / LogLuminanceAvg;
    //float TargetExposure = -log2(1 - TargetLuminance) / LogAvgLuminance;

    float CurrentExposure = Exposure[0];
    float FinalExposure = lerp(CurrentExposure, TargetExposure, AdaptationRate);
    FinalExposure = clamp(FinalExposure, MinExposure, MaxExposure);

    if (GroupIndex == 0)
    {
        Exposure[0] = FinalExposure;
        Exposure[1] = 1.0 / FinalExposure;
        Exposure[2] = FinalExposure;
        Exposure[3] = WeightedHistAvg;

        float BiasToCenter = (floor(WeightedHistAvg) - 118.0) / 255.0;
        if (abs(BiasToCenter) > 0.1)
        {
            MinLog += BiasToCenter * RcpLogRange;
            MaxLog += BiasToCenter * RcpLogRange;
        }
        Exposure[4] = MinLog;
        Exposure[5] = MaxLog;
        Exposure[6] = LogRange;
        Exposure[7] = 1.0 / LogRange;
    }
}
