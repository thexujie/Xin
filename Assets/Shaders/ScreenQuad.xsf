#include "Common.xsh"

struct VSOutput
{
    float4 Position : SV_POSITION;
    float2 Texcoord : TEXCOORD;
};

VSOutput MainVS(uint VertexID : SV_VertexID)
{
    VSOutput Output;
    float ZValue = 0.5f;
    switch (VertexID)
    {
    case 0:
        Output.Position = float4(-1, 3, ZValue, 1);
        Output.Texcoord = float2(0, -1);
        break;
    case 1:
        Output.Position = float4(3, -1, ZValue, 1);
        Output.Texcoord = float2(2, 1);
        break;
    case 2:
        Output.Position = float4(-1, -1, ZValue, 1);
        Output.Texcoord = float2(0, 1);
        break;
    default:
        Output.Position = float4(-1, 2, ZValue, 1);
        Output.Texcoord = float2(0, -1);
        break;
    }
    return Output;
}
