#include "Common.xsh"
#include "Utility.xsh"

Texture2D Bloom;
Texture2D BloomBlend;

cbuffer ShaderParameter
{
    float2 InputTexelSize;
    float BloomBlendFactor;
}

float4 MainPS(float4 Position : SV_POSITION, float2 Texcoord : TEXCOORD) : SV_Target
{
    float4 Result = lerp(
			Bloom.SampleLevel(PointSampler, Texcoord, 0),
			BloomBlend.SampleLevel(LinearBorderSampler, Texcoord, 0),
			BloomBlendFactor);
    return Result;
}
